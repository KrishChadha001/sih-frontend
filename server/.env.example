# Copy to .env and adjust. All values here have working defaults, so .env
# is optional for local hackathon dev.

# SQLite by default; point this at Postgres later without touching app code
# (e.g. postgresql+psycopg://user:pass@host/dbname).
DATABASE_URL=sqlite:///./data/iv_drip.db

# POST /api/v1/readings requires "Authorization: Bearer <token>". Leave
# blank and the server will generate one on first run and write it back
# to .env (see app/config.py) - check the startup log for the value.
# Must match the ESP32's API_AUTH_TOKEN.
API_AUTH_TOKEN=

# Comma-separated origins allowed to call this API from a browser dashboard.
CORS_ORIGINS=*
